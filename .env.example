# Optional: enable the contact form to send email directly via EmailJS.
# Without these set, the contact form gracefully falls back to opening
# the visitor's email client instead — no errors, no broken UI.
# Get these values from https://www.emailjs.com after creating a service + template.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
